# Local dev secrets for `npm run dev` (wrangler dev). Copy to `.dev.vars` and fill in.
# Production secrets are set separately with: npx wrangler secret put <NAME>
# (or via the Cloudflare dashboard → Workers → zhong → Settings → Variables).

# Provider selection: deepseek | openai | openai-compatible
AI_PROVIDER=deepseek

# DeepSeek (default provider)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# OpenAI (set AI_PROVIDER=openai to use)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Any OpenAI-compatible endpoint (set AI_PROVIDER=openai-compatible to use)
# e.g. Groq, Together, Moonshot, Ollama (/v1), LM Studio
AI_API_KEY=
AI_BASE_URL=http://localhost:11434/v1
AI_MODEL=llama3
